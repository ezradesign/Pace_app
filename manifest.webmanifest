    { "src": "/beta/respira-es.webp", "sizes": "540x960", "type": "image/webp", "form_factor": "narrow", "label": "Respira: una técnica guiada, con voz" },
    { "src": "/beta/logros-es.webp", "sizes": "540x960", "type": "image/webp", "form_factor": "narrow", "label": "Los logros: sellos de cuaderno de campo, sin rachas que castigan" },
    { "src": "/premium/app-escritorio-es-claro.webp", "sizes": "1440x900", "type": "image/webp", "form_factor": "wide", "label": "La pantalla de PACE: el aro del Foco y el día de «A tu ritmo»" }
  ],
