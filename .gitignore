# Carpeta espejo de descarga (timestamps locales)
Pace_app/
Pace_app_*/

# Dependencias Node (instaladas localmente para build)
node_modules/

# OpenOffice / LibreOffice lock files (sesión 38b post-incident)
.~lock.*#

# Archivos de backup de editores
*.bak
*~

# Hojas de revision generadas (scripts/audit/*): se regeneran, no se versionan
_revision-*.html
# Maquetas generadas (scripts/audit/maqueta-*.js): mismo criterio que las hojas
# de revision -- lo que se versiona es el GENERADOR, no su salida
_maqueta-*.html
_maqueta-*/
# Capturas y recortes de trabajo (s177): mismo criterio -- se versiona el banco
# que las genera, no la imagen. Llevan el prefijo `_` como todo lo generado.
_*.jpg
_*.png


# Salida de Playwright (s154): informes y trazas se regeneran en cada pasada
test-results/
playwright-report/
blob-report/

# Exports del standalone (s199): se guardan fuera del repo (Releases de GitHub), no en git
backups/

# La web que empaqueta Android: la genera `npm run android:www`
www/

# Lo que publica pacegrass.app: lo genera `npm run web:dist` (y Cloudflare Pages, al publicar)
dist/

# Llaves privadas: NUNCA en el repo. La de los códigos de PACE completo vive en
# ~/PACE-llave-licencias y la de Play en PACE-llave-play, las dos fuera de aquí.
*.pem
PACE-llave-*/

# La medida de los días diseñados (4 MB): se rehace con medir-cuerpo.js
docs/traspaso/archivos/dias-disenados/medir/cuerpo.json
